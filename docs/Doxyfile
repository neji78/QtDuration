#-----------------------------------------------------------
# Doxygen configuration file for QtDuration
#-----------------------------------------------------------

#-------------------------------
# Project related configuration
#-------------------------------

PROJECT_NAME           = "QtDuration"
PROJECT_BRIEF          = "Qt-based duration handling library"
PROJECT_NUMBER         = 1.0.0
PROJECT_LOGO           =
OUTPUT_DIRECTORY       = .
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES

#-------------------------------
# Build related configuration
#-------------------------------

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_PROTECTED      = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_LOCAL_METHODS  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

#-------------------------------
# Input configuration
#-------------------------------

INPUT                  = ../
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.cpp *.hpp *.md
EXCLUDE                = ../build
EXCLUDE_SYMLINKS       = NO

USE_MDFILE_AS_MAINPAGE = README.md
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES

#-------------------------------
# Qt / macro handling
#-------------------------------

QT_AUTOBRIEF           = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = QDURATION_EXPORT= \
                          Q_DURATION_BEGIN_NAMESPACE= \
                          Q_DURATION_END_NAMESPACE=

#-------------------------------
# HTML output
#-------------------------------

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_COLORSTYLE        = LIGHT
HTML_DYNAMIC_MENUS     = YES
HTML_TIMESTAMP         = YES

#-------------------------------
# LaTeX output (optional)
#-------------------------------

GENERATE_LATEX         = NO

#-------------------------------
# Diagram / graph configuration
#-------------------------------

HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
CLASS_DIAGRAMS         = YES
UML_LOOK               = YES
TEMPLATE_RELATIONS     = YES
COLLABORATION_GRAPH    = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO

#-------------------------------
# Source browsing
#-------------------------------

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

#-------------------------------
# Warnings and messages
#-------------------------------

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO

#-------------------------------
# Sorting and grouping
#-------------------------------

SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = YES
SORT_GROUP_NAMES       = YES
GROUP_NESTED_COMPOUNDS = YES

#-------------------------------
# Index generation
#-------------------------------

GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_PATH_NAMES        = NO

#-------------------------------
# Miscellaneous
#-------------------------------

QUIET                  = NO
GENERATE_TAGFILE       = QtDuration.tag
